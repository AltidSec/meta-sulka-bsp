From 856d3ca3b5fbfd015d1157e487ca90940c06f846 Mon Sep 17 00:00:00 2001
From: ejaaskel <esa.jaaskela@suomi24.fi>
Date: Thu, 30 Oct 2025 13:08:30 +0200
Subject: [PATCH] Do not drop into CLI if not unlocked

By default, the system drops into the command line interface if the
autoboot fails. Do not do this if the device is not in the unlocked
state.

Upstream-Status: Pending
---
 common/main.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/common/main.c b/common/main.c
index b0b6e74f5d3..588ebc722db 100644
--- a/common/main.c
+++ b/common/main.c
@@ -19,6 +19,7 @@
 #include <net.h>
 #include <version_string.h>
 #include <efi_loader.h>
+#include <unlocking.h>
 
 static void run_preboot_environment_command(void)
 {
@@ -79,7 +80,13 @@ void main_loop(void)
 		panic("Failed to boot");
 	}
 
-	cli_loop();
+	if (IS_ENABLED(CONFIG_UNLOCKING)) {
+		if (device_is_unlocked()) {
+			cli_loop();
+		}
+	} else {
+		cli_loop();
+	}
 
 	panic("No CLI available");
 }
